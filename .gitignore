# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Service account JSON keys（secrets は routine prompt に埋め込む方式のため git には入れない）
/automation/secrets/sa.json
/automation/secrets/*.json
/automation/secrets/*.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent-teams work logs (not committed)
/agent-teams/logs/
/agent-teams/work/
/agent-teams/research/

# Supabase CLI temp
supabase/.temp/
automation/generated-ledger.json
